FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8 \
    TERM=xterm-256color

RUN apt-get update && apt-get install -y --no-install-recommends \
    # Core shell tools
    bash bash-completion less man-db vim nano tmux \
    # Filesystem utilities
    tree file findutils plocate \
    # Text processing
    grep gawk sed coreutils util-linux \
    # Networking tools
    curl wget iputils-ping net-tools iproute2 traceroute \
    dnsutils netcat-openbsd nmap tcpdump openssh-client mtr-tiny \
    bridge-utils socat tshark \
    # Firewalling
    iptables nftables ufw conntrack \
    # NFS client tools (showmount, rpcinfo, nfsstat)
    nfs-common \
    # Process and performance monitoring
    procps sysstat htop lsof strace ltrace \
    linux-tools-common linux-tools-generic \
    # NIC management
    ethtool \
    # I/O benchmarking
    fio \
    # Filesystem event watching
    inotify-tools \
    # NUMA topology tools
    numactl \
    # Archive tools
    tar gzip bzip2 zip unzip xz-utils rsync \
    # Package management tools
    apt-utils dpkg apt-file \
    # Scripting helpers
    bc jq pv \
    # Namespace and cgroup tools
    cgroup-tools \
    # Linux capabilities (capsh, getcap, setcap)
    libcap2-bin \
    # Audit framework
    auditd audispd-plugins \
    # AppArmor management tools
    apparmor-utils \
    # Disk encryption
    cryptsetup \
    # Software RAID
    mdadm \
    # Compiler, linker, debugger, and binary inspection tools
    gcc binutils gdb \
    # systemd (PID 1 — enables systemctl, journalctl, timers, service management)
    systemd systemd-sysv dbus dbus-user-session \
    # Man page sections 2 (syscalls) and 3 (libc)
    manpages-dev \
    # Development and scripting
    git sudo ca-certificates locales tzdata \
    python3 python3-pip \
    && locale-gen en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

# Install bpftrace for block8 eBPF exercises
RUN apt-get update && apt-get install -y --no-install-recommends \
    bpftrace bpfcc-tools \
    && rm -rf /var/lib/apt/lists/* || true

# Suppress services that don't make sense in a container
RUN systemctl mask \
    systemd-firstboot.service \
    systemd-udevd.service \
    systemd-udevd-control.socket \
    systemd-udevd-kernel.socket \
    systemd-logind.service \
    getty.target \
    console-getty.service \
    sys-fs-fuse-connections.mount \
    sys-kernel-config.mount \
    display-manager.service 2>/dev/null || true

# Install yq (YAML processor) — arch-aware download
RUN ARCH=$(dpkg --print-architecture) && \
    curl -fsSL "https://github.com/mikefarah/yq/releases/download/v4.44.1/yq_linux_${ARCH}" \
    -o /usr/local/bin/yq && chmod +x /usr/local/bin/yq

# Create non-root student user with passwordless sudo
RUN useradd -m -s /bin/bash student \
    && echo "student ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/student \
    && chmod 0440 /etc/sudoers.d/student

# Pre-create practice directory used by exercise check scripts
RUN mkdir -p /home/student/practice \
    && chown -R student:student /home/student

# Build plocate database for locate exercises
RUN updatedb 2>/dev/null || true

# systemd as PID 1. Exec sessions run as student via ContainerExecCreate.
# Container requires: --privileged --cgroupns=host
STOPSIGNAL SIGRTMIN+3
CMD ["/lib/systemd/systemd"]
